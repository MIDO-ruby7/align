{
	"name": "align",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "react-router build",
		"dev": "react-router dev",
		"typecheck": "wrangler types && react-router typegen && tsc -b",
		"deploy": "pnpm run build && wrangler deploy",
		"preview": "pnpm run build && vite preview",
		"cf-typegen": "wrangler types",
		"postinstall": "wrangler types",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "wrangler d1 migrations apply align-db --local",
		"db:seed": "wrangler d1 execute align-db --local --file=db/seed.sql",
		"lint": "eslint .",
		"format": "prettier --write .",
		"test": "vitest run"
	},
	"dependencies": {
		"better-auth": "^1.2.9",
		"drizzle-orm": "^0.44.1",
		"isbot": "^5.1.36",
		"lucide-react": "^1.21.0",
		"react": "^19.2.7",
		"react-dom": "^19.2.7",
		"react-router": "^7.10.0"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "^1.41.0",
		"@cloudflare/workers-types": "^4.20250620.0",
		"@eslint/js": "^9.29.0",
		"@react-router/dev": "^7.10.0",
		"@tailwindcss/vite": "^4.2.2",
		"@types/node": "^22.19.21",
		"@types/react": "^19.2.14",
		"@types/react-dom": "^19.2.3",
		"drizzle-kit": "^0.31.1",
		"eslint": "^9.29.0",
		"eslint-config-prettier": "^10.1.5",
		"globals": "^16.2.0",
		"prettier": "^3.5.3",
		"tailwindcss": "^4.2.2",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.34.0",
		"vite": "^7.3.5",
		"vite-tsconfig-paths": "^6.1.1",
		"vitest": "^3.2.3",
		"wrangler": "^4.101.0"
	}
}
